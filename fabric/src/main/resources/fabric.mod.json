{
  "schemaVersion": 1,
  "id": "colorwheel",
  "version": "${version}",
  "name": "Colorwheel for Create Fly",
  "description": "Allows you to use Iris Shaders with Flywheel",
  "authors": [
    "djefrey",
    "MarekWojt"
  ],
  "contact": {
    "homepage": "https://modrinth.com/project/colorwheel-for-create-fly",
    "sources": "https://github.com/MarekWojt/Colorwheel",
    "issues": "https://github.com/MarekWojt/Colorwheel/issues"
  },
  "license": "AGPL-3.0-only",
  "icon": "logo.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "dev.djefrey.colorwheel.fabric.ClrwlFabric"
    ],
    "client": [
      "dev.djefrey.colorwheel.fabric.client.ClrwlFabricClient"
    ]
  },
  "mixins": [
    "colorwheel.mixins.json",
    {
      "config": "colorwheel.fabric.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "colorwheel.classtweaker",
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": ">=26.1- <26.2-",
    "java": ">=25",
    "fabric-api": "*",
    "iris": ">=1.10.0"
  },
  "recommends": {
    "create": "*"
  },
  "suggests": {
    "colorwheel_patcher": ">=1.0.0"
  },
  "breaks": {
    "irisflw": "*"
  }
}
